# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Private campaign data: lives in the database, never in git ---
transcripts/
private/
exports/
notes/
*.docx
*.doc
*.pdf
*.txt
!requirements*.txt
!app/data/sword_coast_places.txt
*.srt
*.vtt
*.m4a
*.mp3
*.wav
# ...except the dice sounds that ship with the 3D dice library (no recordings live there)
!app/static/vendor/dice-box-threejs-*/sounds/**/*.mp3

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Local tooling ---
.DS_Store
.idea/
.vscode/
*.log
logs/

# Screenshots made while reproducing a bug (Oct 26: seven were committed by mistake). Real pages never go in git.
/repro_*.png

# The saved D&D Beyond sheets, readable copies: never committed (the books' words); tests/fixtures/ddb.locked holds them (scripts/fixtures.py)
tests/fixtures/ddb/*.json

# the linters' own tools (tools/lint), installed by npm ci
node_modules/

# Claude's scratch work (worktrees, notes): never part of the repo
scratchpad/

# mutation testing's working copy (foundations F8)
mutants/
