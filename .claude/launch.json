{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "processor",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "transcript_filter.web"
      ],
      "port": 8765,
      "url": "http://127.0.0.1:8765"
    },
    {
      "name": "web",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--env-file",
        ".env",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web-staging",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "STAGING=1 uv run --env-file .env uvicorn app.main:app --port 8002"
      ],
      "port": 8002
    },
    {
      "name": "web-new",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../dndsy-design && uv run --env-file ../dndsy/.env uvicorn app.main:app --port 8001"
      ],
      "port": 8001
    },
    {
      "name": "web-spellbar",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../dndsy-spellbar && uv run --env-file ../dndsy/.env uvicorn app.main:app --port 8010"
      ],
      "port": 8010
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8020",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/mockups"
      ],
      "port": 8020
    },
    {
      "name": "web-feedback",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../dndsy-feedback && uv run --env-file ../dndsy/.env uvicorn app.main:app --port 8003"
      ],
      "port": 8003
    }
  ]
}
