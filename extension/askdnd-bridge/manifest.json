{
  "manifest_version": 3,
  "name": "askdnd bridge",
  "version": "0.9.8",
  "description": "Keeps your D&D Beyond sheet and askdnd in step, both ways, and hears the turns of a fight in D&D Beyond's VTT.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.dndbeyond.com/*",
    "https://beta.askdnd.ai/*",
    "https://askdnd.ai/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/characters/*"
      ],
      "js": [
        "ddb.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.dndbeyond.com/*"
      ],
      "exclude_matches": [
        "https://www.dndbeyond.com/characters/*"
      ],
      "js": [
        "carry.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.dndbeyond.com/games/*"
      ],
      "js": [
        "vtt-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.dndbeyond.com/games/*"
      ],
      "js": [
        "vtt.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://beta.askdnd.ai/*",
        "https://askdnd.ai/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "askdnd.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ddb-page.js"
      ],
      "matches": [
        "https://www.dndbeyond.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "askdnd bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
