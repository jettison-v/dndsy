{
  "manifest_version": 3,
  "name": "askdnd bridge (proof)",
  "version": "0.4.1",
  "description": "askdnd beside your own D&D Beyond sheet: hears your sheet's changes and makes askdnd's there, as you. A local proof.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.dndbeyond.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/characters/*"
      ],
      "js": [
        "ddb.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost:8000/*"
      ],
      "js": [
        "askdnd.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ddb-page.js"
      ],
      "matches": [
        "https://www.dndbeyond.com/*"
      ]
    }
  ]
}
