{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "railway.backup.json",
      "scripts/backup_db.py",
      "app/__init__.py",
      "app/backup.py",
      "app/config.py",
      "app/db.py",
      "app/history.py",
      "app/models.py",
      "pyproject.toml",
      "uv.lock",
      ".python-version"
    ]
  },
  "deploy": {
    "startCommand": "python scripts/backup_db.py",
    "cronSchedule": "0 10 * * *",
    "restartPolicyType": "ON_FAILURE"
  }
}
