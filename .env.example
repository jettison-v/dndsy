# Copy to .env for local development. Never commit .env.
# In production these are set as Railway service variables.
# Set secrets with scripts/set-secret.sh NAME so they never appear on screen.

# Which environment the app is running in: development | production
APP_ENV=development

# Postgres connection string. Railway injects this automatically from the
# Postgres service (reference variable ${{Postgres.DATABASE_URL}}).
# Locally, leave blank until we need a database.
DATABASE_URL=

# Port the web server listens on. Railway sets this automatically.
PORT=8000

# Signs the login cookie. Any long random string; required in production.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Google sign-in (Google Cloud Console → Google Auth Platform → Clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google emails allowed to sign in.
ALLOWED_EMAILS=

# Anthropic API key (console.anthropic.com, askdnd workspace with a spend limit).
ANTHROPIC_API_KEY=
