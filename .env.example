# Copy to .env for local development. Never commit .env.
# In production these are set as Railway service variables.
# Set secrets with scripts/set-secret.sh NAME so they never appear on screen.

# Which environment the app is running in: development | production
APP_ENV=development

# Postgres connection string. Railway injects this automatically from the
# Postgres service (reference variable ${{Postgres.DATABASE_URL}}).
# Locally, leave blank to use postgresql://localhost/askdnd_dev (Homebrew Postgres).
DATABASE_URL=
# Tests use postgresql://localhost/askdnd_test unless this is set.
TEST_DATABASE_URL=

# Port the web server listens on. Railway sets this automatically.
PORT=8000

# Signs the login cookie. Any long random string; required in production.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Google sign-in (Google Cloud Console → Google Auth Platform → Clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who can sign in is managed on Manage › People (stored in the database). These
# lists still work as a floor: ALLOWED_EMAILS can sign in, REVIEWER_EMAILS are at
# least reviewers, and ADMIN_EMAILS are owners who are always admins (they can't
# be removed or demoted in the app, so the owner can't be locked out).
ALLOWED_EMAILS=
ADMIN_EMAILS=
REVIEWER_EMAILS=

# Shared secret for the local Processor's "Send to askdnd" (same value on Railway and
# in your local .env). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
UPLOAD_TOKEN=
# Where the Processor sends transcripts (local .env only).
ASKDND_URL=https://beta.askdnd.ai

# Anthropic API key (console.anthropic.com, askdnd workspace with a spend limit).
ANTHROPIC_API_KEY=

# Publishing a session starts Claude drafting the next one (about 13¢). On in production,
# off locally unless set to 1 (handy when testing with a copy of beta's data: scripts/pull_beta.sh).
AUTO_DRAFT=

# Local development only: visit /dev/login to sign in as this email without Google
# (for previewing pages). Ignored in production.
DEV_LOGIN_EMAIL=

# Nightly database backup (the askdnd-backup Railway service runs scripts/backup_db.py).
# A key that can only use s3://askdnd-ai/v2/backups/ (see docs/SETUP_LOG.md). Set the
# two secrets with: scripts/set-secret.sh AWS_ACCESS_KEY_ID --service askdnd-backup
AWS_S3_BUCKET_NAME=askdnd-ai
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
