# Copy to .env for local development. Never commit .env.
# In production these are set as Railway service variables.
# Set secrets with scripts/set-secret.sh NAME so they never appear on screen.

# Which environment the app is running in: development | production
APP_ENV=development

# Postgres connection string. Railway injects this automatically from the
# Postgres service (reference variable ${{Postgres.DATABASE_URL}}).
# Locally, leave blank to use postgresql://localhost/askdnd_dev (Homebrew Postgres).
DATABASE_URL=
# Tests use their own database per copy of the code, named after its folder (askdnd_test_dndsy, created
# when missing; tests/conftest.py), unless this is set.
TEST_DATABASE_URL=

# Port the web server listens on. Railway sets this automatically.
PORT=8000

# Signs the login cookie. Any long random string; required in production.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Google sign-in (Google Cloud Console → Google Auth Platform → Clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who can sign in, and their role in each campaign (DM, reviewer, player), is managed
# on Manage › People (stored in the database). These lists still work as a floor:
# ALLOWED_EMAILS can sign in, REVIEWER_EMAILS are at least reviewers in every
# campaign, and ADMIN_EMAILS are owners who are always admins (they can't be removed
# or demoted in the app, so the owner can't be locked out).
ALLOWED_EMAILS=
ADMIN_EMAILS=
REVIEWER_EMAILS=

# Shared secret for the local Processor's "Send to askdnd" (same value on Railway and
# in your local .env). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
UPLOAD_TOKEN=
# Where the Processor sends transcripts (local .env only).
ASKDND_URL=https://beta.askdnd.ai

# Anthropic API key (console.anthropic.com, askdnd workspace with a spend limit).
ANTHROPIC_API_KEY=
# Pictures drawn from a description (app/drawing.py, the Picture window's Describe it): OpenAI's Images API.
# Set with scripts/set-secret.sh OPENAI_API_KEY --clipboard. Without it Describe it says it isn't set up.
OPENAI_API_KEY=
# Which OpenAI image model draws them (its names change often); and an estimated cost per picture, for Manage › Usage
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_COST_USD=0.04
# Listen to the recap (app/narration.py, a Labs feature): OpenAI's text to speech reads a published recap. Its model and
# voice (OpenAI's names change often), and an estimated cost per 1,000 characters read, for Manage › Usage
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_COST_PER_1K_CHARS=0.015

# Publishing a session starts Claude drafting the next one (about 13¢). On in production,
# off locally unless set to 1 (handy when testing with a copy of beta's data: scripts/pull_beta.sh).
AUTO_DRAFT=

# Local development only: visit /dev/login to sign in as this email without Google
# (for previewing pages). Ignored in production.
DEV_LOGIN_EMAIL=
# The D&D Beyond bridge (app/ddb_bridge.py, extension/askdnd-bridge): 1 lets it run here (beta and your own computer);
# each campaign still switches it on (Manage › Settings › Virtual tabletop)
DDB_BRIDGE=
# The bridge's test character on D&D Beyond (docs/testing-setup.md): its sheet id and name, for the hourly health read
# and the pre-game check. Defaults: Vi, 172992073.
BRIDGE_TEST_DDB_ID=
BRIDGE_TEST_NAME=
# Tests only (tests/browser/test_extension.py): where the item browser reads D&D Beyond's item list (app/giving.py); unset
# everywhere else
DDB_ITEMS_URL=
# Claude's key to Found, Fixed, Tried (app/fft/api.py /api/fft, scripts/feedback.py): a long random string, the
# same on askdnd.ai and here (scripts/set-secret.sh FEEDBACK_KEY). Unset, Claude's API answers nothing.
FEEDBACK_KEY=
# Discuss with Claude on a Roadmap item (issue 54): the folder this project is in on the Mac that runs Claude's sessions
# (an absolute path; unset, Claude's app asks which folder) and its GitHub repo, owner/name (default jettison-v/dndsy).
DISCUSS_FOLDER=
DISCUSS_REPO=
# Found, Fixed, Tried (app/fft/keys.py): a key per actor and place, each allowed only what it does. FEEDBACK_KEY above
# is Claude's (read, write, ask, checks, deploy). Staging relays its notes to askdnd.ai with FFT_RELAY_KEY (set the same
# on production and with --staging; it may only send notes, which always wait for an admin). The Mac Mini records its
# own runs with FFT_MINI_KEY (production and the Mini; its passes confirm nothing). Unset, that actor has no access.
FFT_RELAY_KEY=
FFT_MINI_KEY=
# Staging relays its notes to this address:
PROD_URL=https://askdnd.ai

# File storage (app/files.py): "s3" is the default on beta (askdnd-v2), keeping files in S3 under v2/files/ with the
# bucket, region and key below (user askdnd-v2-files: read and write v2/files/ only). Locally it's a folder,
# private/files unless set. Until the key is set on beta, pictures stay in the database only.
FILE_STORAGE=

# Nightly database backup (the askdnd-backup Railway service runs scripts/backup_db.py).
# A key that can only use s3://askdnd-ai/v2/backups/, plus list, read and delete in v2/files/ for files.sweep()
# (see docs/SETUP_LOG.md). Set the two secrets with: scripts/set-secret.sh AWS_ACCESS_KEY_ID --service askdnd-backup
# The web service (askdnd-v2) has the same four names with its own files key.
AWS_S3_BUCKET_NAME=askdnd-ai
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Error reporting (sentry.io, project askdnd-v2): errors on beta alert Brett. Leave blank locally, or local testing
# would alert him as if beta broke. Set on both Railway services only:
#   scripts/set-secret.sh SENTRY_DSN --clipboard --railway-only
#   scripts/set-secret.sh SENTRY_DSN --clipboard --railway-only --service askdnd-backup
SENTRY_DSN=
# New Sentry errors filed as issues in askdnd once a day (app/fft/sentry_in.py; Roadmap item 42). A read-only user auth
# token (event:read, project:read, org:read), beta only; SENTRY_ORG and SENTRY_PROJECT are the project's slugs.
#   scripts/set-secret.sh SENTRY_READ_TOKEN --clipboard --railway-only
SENTRY_READ_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Sheets no extension watches are read every this many seconds while the bridge is awake (app/unwatched.py); 0 turns it off
UNWATCHED_SECONDS=30

# Opens tests/fixtures/ddb.locked, the saved D&D Beyond sheets (scripts/fixtures.py). Ask Brett; also a GitHub Actions secret
FIXTURES_KEY=

# The Inbox digest (app/digest.py): Resend's API key (prod only; no key, no email), who it's from, and the hour of
# the table's day (America/Los_Angeles) it goes out
RESEND_API_KEY=
EMAIL_FROM=askdnd <noreply@askdnd.ai>
DIGEST_HOUR=18

# Background jobs (app/jobs.py, app/worker.py; Roadmap item 43): where they run. "inline" (the default) runs them on
# threads inside the web app; "worker" leaves them to the separate askdnd-worker service (production, once it runs).
JOBS_RUNNER=inline
